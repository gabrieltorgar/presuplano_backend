# === Django ===
DEBUG=True
SECRET_KEY=change-me-in-production

# === Domains: SPA and API on the same site (SameSite=Lax session cookies) ===
# Defaults without DEBUG are production's; with DEBUG, local ones. Per environment:
#   production (main): SPA https://itzaka.com     · API api.itzaka.com
#   develop:           SPA https://dev.itzaka.com · API api-dev.itzaka.com
#   local:             SPA http://localhost:5173  · API localhost:8000

# API hosts (Vercel's deployment hosts are added): production api.itzaka.com, develop api-dev.itzaka.com.
ALLOWED_HOSTS=localhost,127.0.0.1
# SPA exact origins, comma separated, never wildcards (also trusted for CSRF): production https://itzaka.com, develop https://dev.itzaka.com.
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Extra exact origins trusted for CSRF, besides the CORS ones (usually empty).
CSRF_TRUSTED_ORIGINS=
# Parent domain of the CSRF cookie the SPA reads: .itzaka.com in production and develop (the default without DEBUG); empty locally (host-only). JWT cookies never get a Domain.
CSRF_COOKIE_DOMAIN=
# Django's default name in production and locally; develop adds the _dev suffix (both share .itzaka.com). The SPA repeats it (VITE_CSRF_COOKIE_NAME).
CSRF_COOKIE_NAME=csrftoken

# === Database ===
# Local dev/test default is SQLite; production uses Neon Postgres:
# DATABASE_URL=postgres://user:pass@host:5432/dbname
DATABASE_URL=sqlite:///db.sqlite3
# Neon: DATABASE_URL is the pooled host (-pooler, transaction mode); keep 0 there.
CONN_MAX_AGE=0
# Direct (unpooled) host, for migrate and createcachetable (never the pooler).
DATABASE_URL_UNPOOLED=
# Direct host with the owner role (multi-company); preferred for migrations.
DATABASE_URL_MIGRATIONS=

# === Logging ===
LOG_DIR=tmp/logs

# === Environment ===
# Which environment this is: develop, production or a developer machine; missing means production (fail closed), and a Vercel Production deployment is always production.
APP_ENV=local

# === OTP: one-time codes by email ===
# E2E-only universal code: only with APP_ENV local or develop (settings refuse to load with it anywhere else, never in Vercel Production), only for OTP_UNIVERSAL_EMAILS and only to verify an account.
OTP_UNIVERSAL_CODE=
# Comma-separated accounts the universal code verifies (the E2E users).
OTP_UNIVERSAL_EMAILS=
OTP_TTL_MINUTES=10
# Failed tries a code survives before it is voided.
OTP_MAX_ATTEMPTS=5
# Seconds between two codes for the same email and purpose (also for unknown emails).
OTP_RESEND_COOLDOWN_SECONDS=60
# Codes per hour for the same email and purpose.
OTP_MAX_CODES_PER_HOUR=5

# === reCAPTCHA v3 (public forms: signup, login, password reset, contact, invitation) ===
# Server-side secret key, one per environment. Its site key goes to the frontend as VITE_RECAPTCHA_SITE_KEY: set both together. Production (VERCEL_ENV=production) refuses to deploy without it (common.E003).
RECAPTCHA_SECRET_KEY=
# RECAPTCHA_ENABLED: on by default without DEBUG (with or without the key); with DEBUG it follows the key.
# Leave it unset (an empty value reads as False). Production refuses to deploy with it off (common.E004);
# only develop without keys may turn it off:
# RECAPTCHA_ENABLED=False
RECAPTCHA_MIN_SCORE=0.5
# Hosts the tokens may come from: itzaka.com by default without DEBUG, the local one (this value) with DEBUG; develop dev.itzaka.com.
RECAPTCHA_HOSTNAMES=localhost

# === Email — Resend (verification codes, invitations, documents) ===
# Without the key no email goes out. Production refuses to deploy without it.
RESEND_API_KEY=
# A sender of a domain verified in Resend: its test sender (onboarding@resend.dev)
# only delivers to the Resend account owner, and production refuses it too.
RESEND_FROM=CUOTREKA <hola@tu-dominio-verificado.mx>
# Where the links in the emails lead: the application, not the API (production https://itzaka.com, develop https://dev.itzaka.com).
APP_BASE_URL=http://localhost:5173
# On by default where VERCEL_ENV=production: `migrate` stops the deploy when mail
# cannot go out, and a mail that cannot be sent is logged as an error.
REQUIRE_EMAIL_DELIVERY=

# === Scheduled jobs (Vercel cron, vercel.json → crons) ===
# Vercel sends it as «Authorization: Bearer …» to the cron routes; without it they answer 401 and never run.
CRON_SECRET=

# === Rate limiting (DRF throttling; counters in the database cache) ===
# Run `uv run python src/manage.py createcachetable` once after migrating.
THROTTLE_ANON=60/min
THROTTLE_USER=300/min
# Per account per hour for actions that send email or call a paid API (documents, invitations, photo plans).
THROTTLE_COSTLY=20/hour
# Failed admin logins from one IP or for one username before a 15-minute lock (429).
ADMIN_LOGIN_MAX_FAILURES=5
# Proxies in front of Django (Vercel = 1), so limits key on the client IP.
NUM_PROXIES=1

# === Uploads ===
# Max bytes per file through the API (default 4 MiB): a Vercel function rejects bodies over 4.5 MB before Django. On Vercel any upload cap over 4 MiB stops the deploy (core.E002).
UPLOAD_MAX_BYTES=4194304

# === Media storage — Cloudflare R2 (S3-compatible) ===
# Media (progress evidence images) persists in R2 in production. Leave blank to
# use the local filesystem in dev/tests. R2 turns on automatically when the four
# core values are present (or force it with USE_R2=True).
# USE_R2=True
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Optional: defaults to https://<account_id>.r2.cloudflarestorage.com
R2_ENDPOINT_URL=
# Public host that serves the objects (r2.dev subdomain or your custom domain)
R2_PUBLIC_URL=
# Private bucket: signed URLs that expire, from the S3 endpoint (not the public
# host). Turn on after making the bucket private and allowing the app's origin
# in the bucket's CORS policy (the 3D editor fetches textures and meshes).
R2_SIGNED_URLS=False
R2_SIGNED_URL_SECONDS=3600
